# Copiez ce fichier dans .env.local et renseignez votre clé côté serveur uniquement.
# Plusieurs clés possibles, séparées par des virgules : basculement automatique
# quand l'une est épuisée ou invalide. GEMINI_API_KEY reste accepté (une seule clé).
GEMINI_API_KEYS=
GEMINI_API_KEY=
# Modèle facultatif : vérifiez sa disponibilité et son quota dans Google AI Studio.
GEMINI_MODEL=gemini-flash-lite-latest
